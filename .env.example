# project version
PROJECT_VERSION_PREFIX=0.3.0.0
PROJECT_VERSION_SUFFIX=alpha

# build configuration
BUILD_CONFIGURATION=Debug
BUILD_FRAMEWORK=net10.0
BUILD_RUNTIME=linux-musl-x64

# db configuration
DB_USER=root
DB_PASSWORD=password

# bot brain shadow harvest (opt-in diagnostic harness — default OFF)
# DATA-DISCLOSURE SURFACE: arming this writes per-wake bot brain decision
# records (candidates, scores, and the pick the brain made) to disk as JSONL.
# Anyone reading the harvest sees that data, so never arm it in production
# without deciding that explicitly. See Docs/wiki/Soak-Runs.md.
# AAEMU_JEV_SHADOW=1
# AAEMU_JEV_SHADOW_SAMPLE=1
# AAEMU_JEV_SHADOW_PATH=Logs/jev-shadow.jsonl
